{
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "blake3-wasm": "^2.1.5",
    "cssnano": "^9.9.0",
    "gh-pages": "^6.3.0",
    "sass": "^1.17.2",
    "wrangler": "^3.0.0"
  },
  "scripts": {
    "start": "parcel index.html writing.html talks.html article.html",
    "build": "parcel build index.html writing.html talks.html article.html --out-dir dist --public-url ./ && node scripts/build-article-routes.js",
    "deploy": "npm run gh-pages",
    "deploy:cf": "node scripts/deploy-pages.js dist",
    "gh-pages": "gh-pages -d dist -b gh-pages"
  },
  "dependencies": {
    "babel-polyfill": "^6.26.0",
    "parcel": "^2.16.4",
    "parcel-plugin-static-files-copy": "^2.0.0",
    "playwright": "^1.59.1"
  },
  "staticFiles": {
    "staticPath": [
      "public",
      "data"
    ]
  }
}
